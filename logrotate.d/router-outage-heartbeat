/home/*/.local/share/router-outage-heartbeat/heartbeat.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    dateext
    create 0640
    postrotate
        # Send SIGHUP so the process reopens the log file after rotation.
        # Matches specifically against the dist path to avoid signaling other node processes.
        pkill -HUP -f "router-outage-heartbeat/dist/index.js" 2>/dev/null || true
    endscript
}
